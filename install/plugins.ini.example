; GoldHEN: /data/GoldHEN/plugins.ini
; Loads the overlay for ANY game, so every copy of Minecraft works
; (US, EU, Asia, disc or digital, any version).

[default]
/data/GoldHEN/plugins/ps4_overlay_plugin.sprx

; To limit it to Minecraft only, delete [default] above and use the IDs below instead
; (confirmed from the PlayStation Store: CUSA00744 = US, CUSA00265 = EU/Asia):
;
; [CUSA00744]
; /data/GoldHEN/plugins/ps4_overlay_plugin.sprx
; [CUSA00265]
; /data/GoldHEN/plugins/ps4_overlay_plugin.sprx
